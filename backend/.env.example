# Server configuration
PORT=5000
CORS_ORIGINS=http://localhost:8080,https://your-project.vercel.app

# Supabase Auth verification and trusted administrator allowlist
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_ADMIN_USER_IDS=comma-separated-trusted-auth-user-ids
UPLOAD_DIR=./uploads

# Database
MONGO_URI=mongodb://127.0.0.1:27017/task-fe

# Payment provider credentials (server-side only)
RAZORPAY_KEY_ID=replace-with-server-configured-key-id
RAZORPAY_KEY_SECRET=replace-with-server-configured-secret

# Transactional email (server-side only)
EMAIL_USER=replace-with-mailbox
EMAIL_PASS=replace-with-mailbox-app-password
EMAIL_FROM=replace-with-verified-sender

