# Server configuration
PORT=5000
CORS_ORIGINS=http://localhost:8080,https://your-production-domain.example

# Database
MONGO_URI=mongodb://127.0.0.1:27017/task-fe

# Payment provider credentials (server-side only)
RAZORPAY_KEY_ID=replace-with-server-configured-key-id
RAZORPAY_KEY_SECRET=replace-with-server-configured-secret

# Transactional email (server-side only)
EMAIL_USER=replace-with-mailbox
EMAIL_PASS=replace-with-mailbox-app-password
